<file path="src/assets/css/style.css">
/* =========================
   ESTILOS GENERALES
   ========================= */

:root {
    --color-principal: #20A33E;
}


/* =========================
   NAVBAR
   ========================= */

.navbar-brand {
    color: var(--color-principal);
}

.nav-link {
    color: #333;
}

.nav-link:hover,
.nav-link.router-link-active {
    color: var(--color-principal);
}

.logo {
    width: 100px;
    height: 100px;
    padding: 0;
    object-fit: contain;
    margin-right: 10px;
    background-color: aliceblue;
}


/* =========================
   HERO
   ========================= */

.hero {
    background-color: var(--color-principal);
}

.hero .btn {
    color: var(--color-principal);
}

.hero-materiales,
.hero-about {
    background: var(--color-principal);
    padding: 100px 0;
}


/* =========================
   TÍTULOS
   ========================= */

h1 {
    color: white;
}

h2,
h3,
h4 {
    color: var(--color-principal);
}



.contact-header {
    background-color: var(--color-principal);
}

.contact-header h1 {
    color: white;
}

.contact-header p {
    color: white;
    margin-bottom: 0;
}


/* =========================
   CARDS
   ========================= */

.card {
    border: 1px solid #dee2e6;
    border-top: 4px solid var(--color-principal);
    border-radius: 8px;
}

.card-img-top {
    width: 100%;
    height: 220px;
    object-fit: cover;
}

.material-card,
.info-card,
.value-card {
    border-top: 4px solid var(--color-principal);
    transition: transform 0.3s ease;
}

.material-card:hover,
.info-card:hover,
.value-card:hover {
    transform: translateY(-5px);
}


/* =========================
   CARRUSEL
   ========================= */

.carousel-item img {
    height: 250px;
    object-fit: cover;
}

.collage-img {
    width: 100%;
    height: 250px;
    object-fit: cover;
    border-radius: 10px;
}


/* =========================
   CONTACTO
   ========================= */

iframe {
    border-radius: 8px;
}


/* =========================
   NOSOTROS
   ========================= */

.icon-circle {
    width: 80px;
    height: 80px;
    margin: auto;
    border-radius: 50%;
    background-color: var(--color-principal);
    color: white;
    font-size: 35px;
    display: flex;
    align-items: center;
    justify-content: center;
}


/* =========================
   FOOTER
   ========================= */

.footer {
    background-color: var(--color-principal);
}

.footer a {
    color: white;
}
